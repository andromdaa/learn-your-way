{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "defaultMode": "opusplan",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "outputStyle": "direct-compact",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/guard-schema.py"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git worktree add *)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/worktree-uv-setup.sh",
            "timeout": 300,
            "statusMessage": "Setting up uv venv in new worktree…"
          }
        ]
      }
    ]
  }
}
